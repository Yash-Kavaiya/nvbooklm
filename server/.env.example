# Environment Variables for nvbooklm Server

# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase (Required)
# Option 1: Use service account file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Option 2: Set project ID for default credentials
FIREBASE_PROJECT_ID=your-firebase-project-id

# Gemini AI (Required)
GEMINI_API_KEY=your-gemini-api-key

# Qdrant Vector Database
# For local development: http://localhost:6333
# For Qdrant Cloud: https://xxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
